          "commercial_live_query_allowed": true
        },
        {
          "name": "NC OneMap ArcGIS Services",
          "type": "state_parcel",
          "url": "https://services.nconemap.gov/secure/rest/services",
          "machine_readable": true,
          "commercial_live_query_allowed": true
        }
      ],

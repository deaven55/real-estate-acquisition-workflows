{
  "version": 1,
  "description": "Provider-neutral jurisdiction source registry for official public-record discovery. Curated entries are accelerators, not the only allowed sources; WF-020 must retain controlled discovery fallback for jurisdictions not listed here.",
  "source_priority": [
    "state_parcel",
    "county_gis",
    "county_property",
    "county_tax",
    "county_land",
    "county_open_data",
    "court_probate",
    "foreclosure",
    "permit_code_enforcement"
  ],
  "fallback_policy": {
    "use_official_sources_first": true,
    "allow_discovery_for_unknown_jurisdictions": true,
    "require_source_url_or_source_record_id": true,
    "require_owner_and_property_identity_before_ingest": true,
    "do_not_infer_distress_from_missing_data": true
  },
  "jurisdictions": {

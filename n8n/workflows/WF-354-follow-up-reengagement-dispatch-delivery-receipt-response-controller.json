    {
      "parameters": {
        "jsCode": "const input=$json??{}; const event=input.event??input;\nconst dealId=event.deal_id??event.dealId, leadId=event.lead_id??event.leadId, propertyId=event.property_id??event.propertyId;\nconst channel=String(event.channel??event.preferred_channel??'sms').toLowerCase();\nconst phone=event.phone??event.seller?.phone, email=event.email??event.seller?.email;\nconst message=String(event.message??event.body??'').trim();\nconst dnc=Boolean(event.dnc??event.do_not_contact), blockers=Array.isArray(event.blockers)?event.blockers:[];\nconst attempts=Number(event.attempts??0), maxAttempts=Number(event.max_attempts??3);\nconst baseKey=event.idempotency_key??[dealId,leadId,propertyId,'seller-followup'].filter(Boolean).join(':');\nconst idempotencyKey=baseKey+':dispatch:'+attempts;\nlet route='WF-347', decision='dispatch_ready';\nif(dnc){route='WF-126';decision='dnc_hard_stop';}\nelse if(blockers.length){route='WF-126';decision='blocked';}\nelse if(!dealId||!leadId||!propertyId||!baseKey){route='WF-353';decision='identity_or_idempotency_missing';}\nelse if(attempts>=maxAttempts){route='WF-126';decision='human_review_max_attempts';}\nelse if(!message){route='WF-346';decision='message_missing';}\nelse if(channel==='sms'&&!phone){route=email?'WF-347':'WF-352';decision='sms_contact_missing';}\nelse if(channel==='email'&&!email){route=phone?'WF-347':'WF-352';decision='email_contact_missing';}\nreturn [{json:{...event,workflow:'WF-354',decision,route,deal_id:dealId,lead_id:leadId,property_id:propertyId,channel,phone,email,message,attempts,max_attempts:maxAttempts,idempotency_key:idempotencyKey,audit_event:'seller_followup_reengagement_dispatch_controller'}}];"
      },
      "id": "wf354-controller",
      "name": "Controller — Dispatch Safety & Routing",

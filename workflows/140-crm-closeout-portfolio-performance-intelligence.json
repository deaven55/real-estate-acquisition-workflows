    {
      "parameters": {
        "jsCode": "const input=$json.body??$json; const deal=input.deal??input; const economics=input.economics??input.profit_verification??deal.economics??{}; const net=Number(economics.actual_net_profit??economics.net_profit??0); const fee=Number(economics.assignment_fee??0); const cost=Number(economics.closing_costs??0)+Number(economics.marketing_costs??0)+Number(economics.other_costs??0); const roi=cost>0?net/cost:null; const days=Number(input.days_to_close??deal.days_to_close??0); const strategy=deal.exit_strategy??input.exit_strategy??'unknown'; const market=input.market??deal.market??{}; const performance={net_profit:net,assignment_fee:fee,total_costs:cost,profit_margin:fee>0?net/fee:null,roi,days_to_close:days,exit_strategy:strategy}; const intelligence={profit_band:net>=25000?'high':net>=10000?'medium':'low',execution_speed:days>0?(days<=21?'fast':days<=45?'normal':'slow'):'unknown',market:market,lessons:net>0?['Positive realized profit','Capture actual costs and timeline for future underwriting']:['Review acquisition, underwriting, negotiation, and exit assumptions']}; const status=net>0?'performance_recorded':'performance_exception'; const route=status==='performance_recorded'?'portfolio_intelligence_update':'human_review'; return [{json:{workflow_id:'WF-140',workflow_name:'CRM Closeout → Portfolio Performance & Deal Intelligence',status,route,deal_id:deal.id??deal.deal_id??null,lead_id:deal.lead_id??null,property_id:deal.property_id??null,performance,intelligence,next_workflow:route,crm_activity:{event_type:'crm_closeout_portfolio_performance',outcome:status,route,deal_id:deal.id??deal.deal_id??null},idempotency_key:'wf-140:portfolio-intelligence:'+(deal.id??deal.deal_id??input.event_id??'unknown')}}}];"
      },
      "id": "140-intelligence",
      "name": "Build Performance Intelligence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -650,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "matchType": "all",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.status}}",
              "rightValue": "performance_recorded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },

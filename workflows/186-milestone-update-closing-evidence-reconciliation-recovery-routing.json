        "jsCode": "const x=$json??{};const ms=Array.isArray(x.milestones)?x.milestones:(Array.isArray(x.monitoring?.milestones)?x.monitoring.milestones:[]);const evidence=Array.isArray(x.closing_evidence)?x.closing_evidence:(Array.isArray(x.evidence)?x.evidence:[]);const required=Array.isArray(x.required_evidence)?x.required_evidence:[];const blockers=Array.isArray(x.blockers)?x.blockers.filter(Boolean):[];const verified=new Set(evidence.filter(e=>e.verified===true||e.status==='verified').map(e=>String(e.type??e.name??'').trim()).filter(Boolean));const missing=required.map(v=>String(typeof v==='string'?v:(v.type??v.name??'')).trim()).filter(Boolean).filter(v=>!verified.has(v));const incomplete=ms.filter(m=>m.status!=='completed'&&m.completed!==true);const failed=ms.filter(m=>m.status==='failed'||m.status==='blocked');let status=blockers.length?'blocked':failed.length?'recovery_required':missing.length?'evidence_gap':incomplete.length?'milestones_incomplete':'reconciled';const route=status==='reconciled'?'WF-187':status==='blocked'?'WF-126':status==='recovery_required'||status==='evidence_gap'?'WF-174':'WF-155';return[{json:{...x,workflow:'WF-186',reconciliation:{status,verified_evidence_count:verified.size,missing_required_evidence:missing,incomplete_milestones:incomplete.map(m=>m.id??m.name??m.sequence),failed_milestones:failed.map(m=>m.id??m.name??m.sequence),blockers},routing:{next_workflow:route,requires_human_review:status==='blocked'||status==='recovery_required'},audit:{event:'closing_evidence_reconciliation_evaluated',status}}}];"

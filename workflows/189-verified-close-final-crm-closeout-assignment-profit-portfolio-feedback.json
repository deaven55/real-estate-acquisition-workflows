        "jsCode": "const x=$json??{};const v=x.verified_close??{};const p=x.profit_reconciliation??{};const net=Number(v.net_profit??p.net_profit??0);const verified=v.status==='verified_close';const leadId=String(x.lead_id??'').trim();const dealId=String(x.deal_id??'').trim();const propertyId=String(x.property_id??'').trim();const closeId=String(x.close_id??x.closing_id??('close:'+dealId)).trim();const blockers=Array.isArray(x.blockers)?x.blockers.filter(Boolean):[];const missing=[];if(!verified)missing.push('verified_close');if(!dealId)missing.push('deal_id');if(!leadId)missing.push('lead_id');if(!propertyId)missing.push('property_id');if(!closeId)missing.push('close_id');let status=blockers.length?'blocked':missing.length?'closeout_data_incomplete':'closeout_ready';const route=status==='closeout_ready'?'WF-190':status==='blocked'?'WF-126':'WF-188';const record={close_id:closeId,deal_id:dealId,lead_id:leadId,property_id:propertyId,verified_close:true,gross_profit:Number(v.gross_profit??p.gross_profit??0),total_costs:Number(v.total_costs??p.total_costs??0),net_profit:Number.isFinite(net)?net:null,closed_at:x.closed_at??v.closing_date??new Date().toISOString()};return[{json:{...x,workflow:'WF-189',crm_closeout:{status,missing_requirements:missing,profit_record:record,portfolio_feedback:{net_profit:record.net_profit,deal_type:x.deal_type??'unknown',exit_strategy:x.exit_strategy??'unknown'}},routing:{next_workflow:route,requires_human_review:status==='blocked'},audit:{event:'verified_close_final_crm_closeout_evaluated',status}}}];"

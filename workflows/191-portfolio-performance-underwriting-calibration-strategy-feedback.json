        "jsCode": "const x=$json??{};const pp=x.portfolio_performance??{};const r=pp.performance_record??x.performance_record??{};const verified=pp.status==='performance_record_ready'||x.status==='performance_record_ready';const net=Number(r.net_profit??0),costs=Number(r.total_costs??0),gross=Number(r.gross_profit??0);const margin=Number.isFinite(gross)&&gross!==0?net/gross:null;const historical=x.historical_underwriting??{};const sampleSize=Number(historical.sample_size??x.sample_size??0);const avgNet=Number(historical.avg_net_profit??x.avg_net_profit??0);const avgMargin=Number(historical.avg_profit_margin??x.avg_profit_margin??0);const positiveRate=Number(historical.positive_close_rate??x.positive_close_rate??0);const blockers=Array.isArray(x.blockers)?x.blockers.filter(Boolean):[];const missing=[];if(!verified)missing.push('portfolio_performance');if(!r.deal_id)missing.push('deal_id');if(!r.close_id)missing.push('close_id');if(!Number.isFinite(net))missing.push('net_profit');let status=blockers.length?'blocked':missing.length?'calibration_data_incomplete':'calibration_ready';const deltas={net_profit_vs_history:Number.isFinite(net)&&Number.isFinite(avgNet)?net-avgNet:null,margin_vs_history:Number.isFinite(margin)&&Number.isFinite(avgMargin)?margin-avgMargin:null};const calibration={sample_size:sampleSize,observed_net_profit:Number.isFinite(net)?net:null,observed_margin:margin,historical_avg_net_profit:Number.isFinite(avgNet)?avgNet:null,historical_avg_margin:Number.isFinite(avgMargin)?avgMargin:null,historical_positive_close_rate:Number.isFinite(positiveRate)?positiveRate:null,deltas,signals:{profit_performance:Number.isFinite(net)?(net>0?'positive':net<0?'negative':'neutral'):'unknown',margin_performance:Number.isFinite(margin)&&Number.isFinite(avgMargin)?(margin>avgMargin?'above_history':margin<avgMargin?'below_history':'at_history'):'unknown'}};const route=status==='calibration_ready'?'WF-192':status==='blocked'?'WF-126':'WF-190';return[{json:{...x,workflow:'WF-191',underwriting_calibration:{status,missing_requirements:missing,calibration},routing:{next_workflow:route,requires_human_review:status==='blocked'},audit:{event:'underwriting_calibration_strategy_feedback_evaluated',status}}}];"
      },

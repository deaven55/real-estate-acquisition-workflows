      "parameters": {
        "jsCode": "const x=$json??{};const c=x.underwriting_calibration??{};const k=c.calibration??x.calibration??{};const verified=c.status==='calibration_ready'||x.status==='calibration_ready';const base=Number(x.base_mao??x.current_mao??x.mao??0);const marginDelta=Number(k.deltas?.margin_vs_history??0);const netDelta=Number(k.deltas?.net_profit_vs_history??0);const positiveRate=Number(k.historical_positive_close_rate??0);const sample=Number(k.sample_size??0);const blockers=Array.isArray(x.blockers)?x.blockers.filter(Boolean):[];const missing=[];if(!verified)missing.push('calibration_ready');if(!Number.isFinite(base)||base<=0)missing.push('base_mao');const confidence=sample>=20?'high':sample>=10?'medium':'low';let factor=1;if(confidence==='high'){if(marginDelta<-0.1||netDelta<0)factor=0.95;else if(marginDelta>0.1&&netDelta>0)factor=1.03;}else if(confidence==='medium'){if(marginDelta<-0.15)factor=0.97;else if(marginDelta>0.15&&netDelta>0)factor=1.02;}const adjusted=Number.isFinite(base)&&base>0?Math.round(base*factor*100)/100:null;let status=blockers.length?'blocked':missing.length?'strategy_data_incomplete':'strategy_adjusted';const route=status==='strategy_adjusted'?'WF-193':status==='blocked'?'WF-126':'WF-191';const strategy={base_mao:base||null,adjusted_mao:adjusted,adjustment_factor:factor,confidence,reason:confidence==='low'?'limited_historical_sample':marginDelta<0?'underperformance_adjustment':marginDelta>0?'outperformance_adjustment':'neutral_adjustment',positive_close_rate:positiveRate};return[{json:{...x,workflow:'WF-192',dynamic_strategy:{status,missing_requirements:missing,strategy},routing:{next_workflow:route,requires_human_review:status==='blocked'||confidence==='low'},audit:{event:'dynamic_mao_strategy_adjustment_evaluated',status}}}];"
      },

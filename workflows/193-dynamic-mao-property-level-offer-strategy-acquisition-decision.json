      "parameters": {
        "jsCode": "const x=$json??{};const d=x.dynamic_strategy??{};const s=d.strategy??x.strategy??{};const property=x.property??{};const base=Number(s.adjusted_mao??x.adjusted_mao??x.mao??0);const ask=Number(property.asking_price??x.asking_price??0);const arv=Number(property.arv??x.arv??0);const repairs=Number(property.repairs??x.estimated_repairs??0);const assignment=Number(x.target_assignment_fee??x.assignment_fee??0);const closing=Number(x.closing_costs??0);const other=Number(x.other_costs??0);const blockers=Array.isArray(x.blockers)?x.blockers.filter(Boolean):[];const missing=[];if(!Number.isFinite(base)||base<=0)missing.push('adjusted_mao');if(!Number.isFinite(ask)||ask<=0)missing.push('asking_price');const allIn=Number.isFinite(ask)?ask+repairs+closing+other:0;const spread=Number.isFinite(base)&&Number.isFinite(ask)?base-ask:null;const projectedProfit=Number.isFinite(base)&&Number.isFinite(ask)?base-ask-repairs-closing-other-assignment:null;let decision='needs_evidence';if(!missing.length){if(blockers.length)decision='blocked';else if(ask<=base&&projectedProfit>=0)decision='pursue';else if(ask<=base*1.05)decision='negotiate';else decision='pass';}const strategy={adjusted_mao:base,asking_price:ask||null,arv:Number.isFinite(arv)&&arv>0?arv:null,estimated_repairs:repairs,all_in_cost:allIn||null,offer_ceiling:base||null,price_spread:spread,projected_assignment_profit:projectedProfit,decision};const route=decision==='pursue'||decision==='negotiate'?'WF-194':decision==='pass'?'WF-195':decision==='blocked'?'WF-126':'WF-191';let status=blockers.length?'blocked':missing.length?'offer_strategy_data_incomplete':decision;return[{json:{...x,workflow:'WF-193',property_offer_strategy:{status,missing_requirements:missing,strategy},routing:{next_workflow:route,requires_human_review:status==='blocked'||decision==='negotiate'},audit:{event:'property_level_offer_strategy_acquisition_decision_evaluated',status}}}];"
      },

      "parameters": {
        "jsCode": "const x=$json??{};const o=x.negotiation_outcome??{};const offer=Number(x.contract_price??o.proposed_price??x.offer_price??0);const mao=Number(x.adjusted_mao??x.dynamic_strategy?.adjusted_mao??x.mao??0);const leadId=String(x.lead_id??'').trim();const propertyId=String(x.property_id??'').trim();const dealId=String(x.deal_id??'').trim();const seller=x.seller??{};const sellerName=String(x.seller_name??seller.name??[seller.first_name,seller.last_name].filter(Boolean).join(' ')??'').trim();const missing=[];if(o.outcome!=='contract_trigger')missing.push('contract_trigger_outcome');if(!leadId)missing.push('lead_id');if(!propertyId)missing.push('property_id');if(!dealId)missing.push('deal_id');if(!Number.isFinite(offer)||offer<=0)missing.push('contract_price');if(mao>0&&offer>mao)missing.push('price_above_mao');if(!sellerName)missing.push('seller_identity');const status=missing.length?'package_incomplete':'signature_ready';const pkg={deal_id:dealId,lead_id:leadId,property_id:propertyId,seller_name:sellerName||null,contract_price:offer||null,adjusted_mao:mao||null,maoprotected:!mao||offer<=mao,agreement_type:String(x.agreement_type??'purchase_agreement'),signature_required:true,package_version:'v1'};const route=status==='signature_ready'?'WF-202':'WF-126';return[{json:{...x,workflow:'WF-201',contract_package:{status,missing_requirements:missing,package:pkg},routing:{next_workflow:route,requires_human_review:true},audit:{event:'contract_trigger_package_validation_signature_launch_evaluated',status}}}];"
      },

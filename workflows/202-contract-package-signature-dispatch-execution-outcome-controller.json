      "parameters": {
        "jsCode": "const x=$json??{};const p=x.contract_package?.package??{};const status=String(x.contract_package?.status??'').toLowerCase();const sig=x.signature??x.signature_status??{};const dispatched=sig.dispatched===true||['dispatched','sent','delivered'].includes(String(sig.status??'').toLowerCase());const signed=sig.signed===true||['signed','executed','completed'].includes(String(sig.status??'').toLowerCase());const declined=sig.declined===true||['declined','rejected','voided'].includes(String(sig.status??'').toLowerCase());const expired=sig.expired===true||String(sig.status??'').toLowerCase()==='expired';const missing=[];if(status!=='signature_ready')missing.push('signature_ready_status');if(!p.deal_id)missing.push('deal_id');if(!p.lead_id)missing.push('lead_id');if(!p.property_id)missing.push('property_id');let state='signature_dispatch_blocked';if(!missing.length){if(signed)state='executed';else if(declined)state='declined';else if(expired)state='expired';else if(dispatched)state='awaiting_signature';else state='dispatch_ready';}const route={executed:'WF-203',declined:'WF-204',expired:'WF-204',awaiting_signature:'WF-203',dispatch_ready:'WF-203',signature_dispatch_blocked:'WF-126'}[state]??'WF-126';return[{json:{...x,workflow:'WF-202',signature_execution:{state,dispatched,signed,declined,expired,signature_id:sig.signature_id??sig.id??null,package_version:p.package_version??null,maoprotected:p.maoprotected??null},routing:{next_workflow:route,requires_human_review:['declined','expired','signature_dispatch_blocked'].includes(state)},audit:{event:'contract_signature_dispatch_execution_outcome_evaluated',status:state}}}];"
      },

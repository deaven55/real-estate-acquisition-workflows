        "jsCode": "const x=$json??{};const s=x.signature_execution??x.signature??{};const p=x.contract_package?.package??{};const executed=s.signed===true||['signed','executed','completed'].includes(String(s.status??'').toLowerCase())||s.execution_confirmed===true;const missing=[];if(!executed)missing.push('executed_signature');for(const k of ['deal_id','lead_id','property_id'])if(!(x[k]??p[k]))missing.push(k);if(!p.agreement_type&& !x.agreement_type)missing.push('agreement_type');if(!(p.contract_price??x.contract_price))missing.push('contract_price');const readiness=missing.length?'blocked':'transaction_ready';const next=readiness==='transaction_ready'?'WF-204':'WF-126';return[{json:{...x,workflow:'WF-203',transaction_readiness:{status:readiness,executed_signature:executed,deal_id:x.deal_id??p.deal_id??null,lead_id:x.lead_id??p.lead_id??null,property_id:x.property_id??p.property_id??null,agreement_type:x.agreement_type??p.agreement_type??null,contract_price:x.contract_price??p.contract_price??null,missing},routing:{next_workflow:next,requires_human_review:readiness!=='transaction_ready'},audit:{event:'signature_execution_transaction_readiness_evaluated',status:readiness}}}];"

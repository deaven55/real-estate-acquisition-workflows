        "jsCode": "const x=$json??{};const c=x.closing_coordination??{};const dates=x.critical_dates??{};const milestones=Array.isArray(x.milestones)?x.milestones:Array.isArray(c.milestones)?c.milestones:[];const closingDate=x.closing_date??c.closing_date??dates.closing_date??null;const missing=[];if(c.status!=='coordination_ready')missing.push('coordination_ready_status');for(const k of ['deal_id','lead_id','property_id'])if(!(x[k]??c[k]))missing.push(k);if(!closingDate)missing.push('closing_date');const overdue=milestones.filter(m=>m?.due_date&&new Date(m.due_date)<new Date()&&!['completed','verified','closed'].includes(String(m.status??'').toLowerCase()));const criticalOverdue=overdue.filter(m=>m?.critical===true||String(m?.priority??'').toLowerCase()==='critical');const completed=milestones.length>0&&milestones.every(m=>['completed','verified','closed'].includes(String(m?.status??'').toLowerCase()));const status=missing.length?'blocked':completed?'milestones_completed':criticalOverdue.length?'critical_overdue':overdue.length?'attention_required':'on_track';const next=status==='milestones_completed'?'WF-206':status==='blocked'?'WF-126':status==='critical_overdue'||status==='attention_required'?'WF-207':'WF-206';return[{json:{...x,workflow:'WF-205',milestone_monitoring:{status,closing_date:closingDate,deal_id:x.deal_id??c.deal_id??null,lead_id:x.lead_id??c.lead_id??null,property_id:x.property_id??c.property_id??null,total_milestones:milestones.length,overdue_count:overdue.length,critical_overdue_count:criticalOverdue.length,completed,missing},routing:{next_workflow:next,requires_human_review:['blocked','critical_overdue','attention_required'].includes(status)},audit:{event:'closing_coordination_critical_dates_milestone_monitoring_evaluated',status}}}];"

      "parameters": {
        "jsCode": "const x=$json??{};const c=x.crm_closeout??{};const gross=Number(c.gross_profit),costs=Number(c.total_closing_costs),net=Number(c.net_profit),margin=Number(c.profit_margin);const identity=Boolean(c.deal_id&&c.lead_id&&c.property_id);const missing=[];if(c.status!=='closeout_ready'&&c.status!=='negative_profit_review')missing.push('closeout_status');if(!identity)missing.push('deal_lead_property_identity');for(const [k,v] of [['gross_profit',gross],['closing_costs',costs],['net_profit',net]])if(!Number.isFinite(v))missing.push(k);let status=missing.length?'blocked':'performance_record_ready';const sample=x.portfolio_sample_size??x.historical_sample_size??null;const underwritingSignal=net>0?(margin>=0.2?'strong_positive':margin>=0.1?'positive':'thin_positive'):net<0?'negative':'neutral';const next=status==='performance_record_ready'?'WF-211':'WF-126';return[{json:{...x,workflow:'WF-210',portfolio_performance:{status,deal_id:c.deal_id??null,lead_id:c.lead_id??null,property_id:c.property_id??null,gross_profit:gross,total_closing_costs:costs,net_profit:net,profit_margin:Number.isFinite(margin)?margin:(gross?net/gross:null),historical_sample_size:sample,underwriting_feedback:{profitability_signal:underwritingSignal,calibration_candidate:net!==0},missing},routing:{next_workflow:next,requires_human_review:status==='blocked'},audit:{event:'final_crm_closeout_portfolio_performance_underwriting_feedback_evaluated',status}}}];"
      },
      "name": "Code — Portfolio Performance Controller",
      "type": "n8n-nodes-base.code",

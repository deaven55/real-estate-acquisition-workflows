        "jsCode": "const x=$json??{};const c=x.underwriting_calibration??{};const base=Number(x.base_mao??x.dynamic_mao??x.mao??0);const factor=Number(c.mao_adjustment_factor??x.mao_adjustment_factor??1);const missing=[];if(c.status!=='calibration_ready')missing.push('calibration_ready_status');if(!Number.isFinite(base)||base<=0)missing.push('base_mao');if(!Number.isFinite(factor)||factor<=0)missing.push('mao_adjustment_factor');const adjusted=missing.length?null:Math.round(base*factor*100)/100;const confidence=c.confidence??'low';const status=missing.length?'blocked':confidence==='low'?'human_review_required':'strategy_adjusted';const next=status==='strategy_adjusted'?'WF-213':'WF-126';return[{json:{...x,workflow:'WF-212',dynamic_mao_strategy:{status,base_mao:base,adjustment_factor:factor,adjusted_mao:adjusted,confidence,rationale:c.rationale??'calibration_signal',historical_sample_size:c.historical_sample_size??0},routing:{next_workflow:next,requires_human_review:status!=='strategy_adjusted'},audit:{event:'underwriting_calibration_dynamic_mao_strategy_adjustment_evaluated',status}}}];"
      },

        "jsCode": "const x=$json??{};const s=x.dynamic_mao_strategy??{};const asking=Number(x.asking_price);const mao=Number(s.adjusted_mao??x.adjusted_mao??x.dynamic_mao);const projected=Number(x.projected_assignment_profit??x.projected_profit);const motivation=Number(x.motivation_score??0);const blockers=Array.isArray(x.blockers)?x.blockers:[];const missing=[];if(s.status!=='strategy_adjusted')missing.push('strategy_adjusted_status');if(!Number.isFinite(mao)||mao<=0)missing.push('adjusted_mao');if(!Number.isFinite(asking)||asking<=0)missing.push('asking_price');let decision='needs_evidence',reason='insufficient_evidence';if(!missing.length){if(blockers.length)decision='pass',reason='blocking_risks';else if(asking<=mao&&projected>0)decision='pursue',reason='asking_price_within_mao_and_positive_profit';else if(asking>mao&&asking<=mao*1.08)decision='negotiate',reason='asking_price_near_mao';else if(asking>mao)decision='pass',reason='asking_price_above_viable_range';else decision='pursue',reason='viable_economics';}const status=missing.length?'blocked':decision==='needs_evidence'?'needs_evidence':'decision_ready';const next=status==='decision_ready'&&(decision==='pursue'||decision==='negotiate')?'WF-214':status==='decision_ready'?'WF-215':'WF-126';return[{json:{...x,workflow:'WF-213',property_offer_strategy:{status,decision,reason,asking_price:asking,adjusted_mao:mao,projected_assignment_profit:Number.isFinite(projected)?projected:null,motivation_score:motivation,blockers,negotiation_band:mao>0?{target:Math.round(mao*.92*100)/100,ceiling:mao}:null},routing:{next_workflow:next,requires_human_review:decision!=='pursue'},audit:{event:'dynamic_mao_property_level_offer_strategy_acquisition_decision_evaluated',status}}}];"

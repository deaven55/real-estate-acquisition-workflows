        "jsCode": "const x=$json??{};const raw=String(x.seller_message??x.response_text??x.message??'').trim();const text=raw.toLowerCase();const amountMatch=raw.replace(/[$,]/g,'').match(/(?:\\$|\\b)(\\d{2,7}(?:\\.\\d{1,2})?)\\b/);const counter=amountMatch?Number(amountMatch[1]):null;let classification='other_response';if(!raw)classification='no_response';else if(/\\b(yes|accept|accepted|deal|agree|sounds good|let's do it|lets do it)\\b/.test(text)&&!/(no|can't|cannot|counter|but)/.test(text))classification='accepted';else if(/\\b(no|reject|rejected|pass|not interested|won't|will not)\\b/.test(text))classification='rejected';else if(counter!==null||/\\b(counter|lower|higher|more|less|offer|price)\\b/.test(text))classification='counteroffer';else if(/\\?|\\b(what|how|when|where|why|can you|could you)\\b/.test(text))classification='question';const status=classification==='no_response'?'needs_followup':'classified';const next=classification==='accepted'?'WF-218':classification==='counteroffer'?'WF-219':classification==='rejected'?'WF-220':'WF-218';return[{json:{...x,workflow:'WF-217',seller_response_classification:{status,classification,response_text:raw,counteroffer_amount:counter,confidence:classification==='other_response'?'low':'high'},routing:{next_workflow:next,requires_human_review:['accepted','counteroffer','rejected'].includes(classification)},audit:{event:'seller_response_offer_counteroffer_classification_negotiation_routing_evaluated',classification,status}}}];"
      },

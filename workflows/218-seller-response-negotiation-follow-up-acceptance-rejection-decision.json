        "jsCode": "const x=$json??{};const c=x.seller_response_classification??{};const mao=Number(x.adjusted_mao??x.dynamic_mao??x.mao??x.property_offer_strategy?.adjusted_mao);const counter=Number(c.counteroffer_amount);const classification=c.classification;const missing=[];if(c.status!=='classified')missing.push('classified_status');if(!x.deal_id)missing.push('deal_id');if(!x.lead_id)missing.push('lead_id');let decision='needs_review',reason='unclassified_or_missing_evidence';if(!missing.length){if(classification==='accepted')decision='acceptance_ready',reason='seller_accepted_offer';else if(classification==='rejected')decision='rejection_reengagement',reason='seller_rejected_offer';else if(classification==='question')decision='clarification_follow_up',reason='seller_question';else if(classification==='counteroffer'){if(!Number.isFinite(counter)||!Number.isFinite(mao)||mao<=0)decision='counteroffer_needs_review',reason='counteroffer_or_mao_missing';else if(counter<=mao)decision='counteroffer_within_mao',reason='counteroffer_within_viable_ceiling';else if(counter<=mao*1.08)decision='counteroffer_near_mao',reason='counteroffer_near_ceiling';else decision='counteroffer_above_mao',reason='counteroffer_above_viable_ceiling';}else decision='follow_up_needed',reason='response_requires_follow_up';}const next=['acceptance_ready','counteroffer_within_mao'].includes(decision)?'WF-219':['counteroffer_near_mao','counteroffer_above_mao','rejection_reengagement','clarification_follow_up','follow_up_needed','counteroffer_needs_review'].includes(decision)?'WF-220':'WF-126';const status=missing.length?'blocked':'decision_ready';return[{json:{...x,workflow:'WF-218',negotiation_decision:{status,decision,reason,counteroffer_amount:Number.isFinite(counter)?counter:null,adjusted_mao:Number.isFinite(mao)?mao:null,requires_human_review:decision!=='counteroffer_within_mao'&&decision!=='follow_up_needed'},routing:{next_workflow:status==='decision_ready'?next:'WF-126',requires_human_review:true},audit:{event:'seller_response_negotiation_follow_up_acceptance_rejection_decision_evaluated',decision,status}}}];"

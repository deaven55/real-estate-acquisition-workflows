      "parameters": {
        "jsCode": "const x=$json??{};const d=x.negotiation_decision??{};const mao=Number(d.adjusted_mao??x.adjusted_mao??x.dynamic_mao);const counter=Number(d.counteroffer_amount);const missing=[];if(d.status!=='decision_ready')missing.push('decision_ready_status');if(!x.deal_id)missing.push('deal_id');if(!x.lead_id)missing.push('lead_id');if(!Number.isFinite(mao)||mao<=0)missing.push('adjusted_mao');let decision='needs_review',reason='insufficient_negotiation_evidence',contractPrice=null,revisedOffer=null;if(!missing.length){if(d.decision==='acceptance_ready'){decision='accept_counteroffer',reason='seller_acceptance_ready',contractPrice=Number(x.offer_price??mao);}else if(d.decision==='counteroffer_within_mao'){decision='accept_counteroffer',reason='counteroffer_within_mao',contractPrice=counter;}else if(d.decision==='counteroffer_near_mao'){revisedOffer=Math.round(mao*.98*100)/100;decision='revised_offer',reason='counteroffer_near_mao';}else if(d.decision==='counteroffer_above_mao'){revisedOffer=Math.round(mao*100)/100;decision='walk_away_or_revised_offer',reason='counteroffer_above_mao';}else decision='needs_review',reason=d.reason??reason;}const status=missing.length?'blocked':'decision_ready';const next=['accept_counteroffer','revised_offer'].includes(decision)?'WF-220':['walk_away_or_revised_offer','needs_review'].includes(decision)?'WF-126':'WF-126';return[{json:{...x,workflow:'WF-219',contract_offer_decision:{status,decision,reason,contract_price:contractPrice,revised_offer_price:revisedOffer,adjusted_mao:mao,counteroffer_amount:Number.isFinite(counter)?counter:null,maO_protected:true,human_review_required:decision!=='revised_offer'},routing:{next_workflow:status==='decision_ready'?next:'WF-126',requires_human_review:decision!=='revised_offer'},audit:{event:'counteroffer_acceptance_revised_offer_contract_decision_evaluated',decision,status}}}];"
      },

    {
      "parameters": {
        "jsCode": "const d=$json.body??$json;const lead_id=d.lead_id??null,deal_id=d.deal_id??null,property_id=d.property_id??null;const base=Number(d.base_mao??NaN),factor=Number(d.adjustment_factor??NaN),confidence=String(d.confidence??\"low\").toLowerCase();const blockers=Array.isArray(d.blockers)?d.blockers:[];const calibrated=Number.isFinite(base)&&Number.isFinite(factor);const adjusted_mao=calibrated?Math.round(base*factor*100)/100:null;let state=\"blocked\",route=\"WF-126\",strategy_status=\"not_ready\",reason=\"Dynamic MAO inputs are incomplete or invalid.\";if(!calibrated){reason=\"Base MAO or calibration factor is invalid.\";}else if(confidence===\"low\"){state=\"calibration_low_confidence\";route=\"WF-126\";strategy_status=\"human_review\";reason=\"Calibration confidence is too low for autonomous MAO adjustment.\";}else if(blockers.length){reason=\"Unresolved blockers prevent strategy adjustment.\";}else{state=\"strategy_adjusted\";route=\"WF-233\";strategy_status=\"adjusted\";reason=\"Confidence-qualified calibration produced a dynamic MAO and strategy adjustment.\";}return[{json:{workflow:\"WF-232\",lead_id,deal_id,property_id,base_mao:base,adjustment_factor:factor,adjusted_mao,confidence,blockers,state,route,strategy_status,reason,maO_protection:{base_mao:base,adjusted_mao,maximum_offer_ceiling:adjusted_mao,override_required:confidence===\"low\"},requires_human_review:state!==\"strategy_adjusted\"}}];"
      },
      "name": "Dynamic MAO Controller",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
